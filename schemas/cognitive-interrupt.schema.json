{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cognitive-interrupt-engine:schema:cognitive-interrupt:0.1",
  "title": "CognitiveInterrupt",
  "description": "Runtime envelope for one durable cognitive obligation. Lifecycle status is recorded as events/index state rather than mutating this envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interrupt_id",
    "obligation_ref",
    "continuation_ref",
    "capability_requirements",
    "input_schema",
    "input",
    "output_schema",
    "created_at"
  ],
  "properties": {
    "interrupt_id": {
      "type": "string",
      "minLength": 1
    },
    "obligation_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "continuation_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque durable reference resolved by the selected runtime adapter."
    },
    "capability_requirements": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "reasoning": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "input_schema": {
      "type": "string",
      "minLength": 1
    },
    "input": true,
    "output_schema": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
